<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- DLL Configuration -->
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
    <AssemblyName>AstroAPIClient</AssemblyName>
    <RootNamespace>AstroAPIClient</RootNamespace>
    
    <!-- Build Output Configuration -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\</IntermediateOutputPath>
    
    <!-- NuGet Package Configuration -->
    <PackageId>AstroAPIClient</PackageId>
    <Version>1.0.0</Version>
    <Authors>Ajeet Kanojia, Suraj Yadav</Authors>
    <Company>AstrologyAPI</Company>
    <Product>AstroAPIClient</Product>
    <Description>AstrologyAPI Client for consuming AstrologyAPIs. A .NET client library for https://json.astrologyapi.com/v1/</Description>
    <Copyright>Copyright © 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://json.astrologyapi.com/v1/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/yourusername/astro-api-net-client</RepositoryUrl>
    <PackageTags>astrology;api;client;horoscope;vedic;western;numerology;matchmaking</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
